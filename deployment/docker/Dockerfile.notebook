# Jupyter development environment with CUDA support
# Based on official Jupyter stack with custom ML additions

FROM jupyter/tensorflow-notebook:latest AS jupyter-base

# Switch to root for system installations
USER root

# Install CUDA development environment
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    gnupg2 \
    software-properties-common \
    && wget https://developer.download.nvidia.com/compute/cuda/repos/ubuntu22.04/x86_64/cuda-keyring_1.0-1_all.deb \
    && dpkg -i cuda-keyring_1.0-1_all.deb \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        cuda-toolkit-12-1 \
        libcudnn8 \
        libcudnn8-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Install additional system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    git-lfs \
    vim \
    htop \
    tmux \
    tree \
    curl \
    build-essential \
    python3-dev \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Set CUDA environment variables
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=${CUDA_HOME}/bin:${PATH}
ENV LD_LIBRARY_PATH=${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}
ENV TORCH_CUDA_ARCH_LIST="7.5;8.0;8.6;8.9;9.0"
ENV CUDA_VISIBLE_DEVICES=0
ENV PYTHONPATH=/home/jovyan/work

# Switch back to jovyan user
USER $NB_UID

# Copy requirements and install Python packages
COPY requirements.txt /tmp/requirements.txt
COPY requirements-notebook.txt* /tmp/

# Install ML packages with CUDA support
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
        torch>=2.4.0 \
        torchvision>=0.19.0 \
        torchaudio>=2.4.0 \
        --index-url https://download.pytorch.org/whl/cu121 && \
    pip install --no-cache-dir -r /tmp/requirements.txt && \
    if [ -f /tmp/requirements-notebook.txt ]; then pip install --no-cache-dir -r /tmp/requirements-notebook.txt; fi && \
    pip cache purge

# Install Jupyter extensions and widgets
RUN pip install --no-cache-dir \
    jupyterlab>=3.6.0 \
    jupyterlab-git \
    jupyterlab-lsp \
    python-lsp-server[all] \
    ipywidgets \
    plotly \
    bokeh \
    voila \
    papermill \
    nbconvert \
    jupyter-dash \
    jupyterlab_widgets \
    && jupyter lab build --dev-build=False --minimize=True

# Install additional data science and visualization packages
RUN pip install --no-cache-dir \
    seaborn \
    plotly \
    altair \
    bokeh \
    dash \
    streamlit \
    gradio \
    shap \
    lime \
    captum \
    optuna \
    hyperopt \
    && pip cache purge

# Set up Git LFS
RUN git lfs install

# Configure Jupyter Lab
RUN jupyter lab --generate-config && \
    echo "c.ServerApp.token = ''" >> ~/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.password = ''" >> ~/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.open_browser = False" >> ~/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.ip = '0.0.0.0'" >> ~/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.port = 8888" >> ~/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.allow_root = False" >> ~/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.allow_origin = '*'" >> ~/.jupyter/jupyter_lab_config.py && \
    echo "c.ServerApp.disable_check_xsrf = True" >> ~/.jupyter/jupyter_lab_config.py

# Create directory structure
RUN mkdir -p /home/jovyan/work/notebooks \
             /home/jovyan/work/data \
             /home/jovyan/work/models \
             /home/jovyan/work/configs \
             /home/jovyan/work/scripts \
             /home/jovyan/work/artifacts

# Switch back to root to set final permissions
USER root
RUN chown -R $NB_USER:$NB_GID /home/jovyan/work && \
    chmod -R 755 /home/jovyan/work

# Switch back to jovyan
USER $NB_UID

# Set working directory
WORKDIR /home/jovyan/work

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8888/lab || exit 1

# Expose Jupyter port
EXPOSE 8888

# Start Jupyter Lab
CMD ["start-notebook.sh", \
     "--NotebookApp.token=''", \
     "--NotebookApp.password=''", \
     "--NotebookApp.allow_origin='*'", \
     "--NotebookApp.disable_check_xsrf=True"]