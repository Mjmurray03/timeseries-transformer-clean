{
  "dashboard": {
    "id": null,
    "uid": "timeseries-transformer",
    "title": "Time-Series Transformer Monitoring",
    "tags": ["ml", "transformer", "production"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "panels": [
      {
        "id": 1,
        "title": "Prediction Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(model_predictions_total[5m])",
            "legendFormat": "{{model_version}} - {{ticker}}",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "ops", "label": "Predictions/sec"}]
      },
      {
        "id": 2,
        "title": "Inference Latency P99",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(model_prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "P99 Latency",
            "refId": "A"
          },
          {
            "expr": "histogram_quantile(0.95, rate(model_prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "P95 Latency",
            "refId": "B"
          },
          {
            "expr": "histogram_quantile(0.50, rate(model_prediction_duration_seconds_bucket[5m]))",
            "legendFormat": "P50 Latency",
            "refId": "C"
          }
        ],
        "yaxes": [{"format": "s", "label": "Latency"}]
      },
      {
        "id": 3,
        "title": "Model Accuracy (RMSE)",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "model_accuracy{metric_type='rmse'}",
            "legendFormat": "RMSE - {{model_version}}",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "short", "label": "RMSE"}],
        "alert": {
          "conditions": [
            {
              "evaluator": {"params": [0.025], "type": "gt"},
              "operator": {"type": "and"},
              "query": {"params": ["A", "5m", "now"]},
              "reducer": {"params": [], "type": "avg"},
              "type": "query"
            }
          ],
          "name": "High RMSE Alert"
        }
      },
      {
        "id": 4,
        "title": "GPU Memory Usage",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "gpu_memory_usage_bytes / 1024 / 1024 / 1024",
            "legendFormat": "GPU {{device}}",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "GB", "label": "Memory"}]
      },
      {
        "id": 5,
        "title": "API Request Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{method}} {{status}}",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "reqps", "label": "Requests/sec"}]
      },
      {
        "id": 6,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"x": 8, "y": 16, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "rate(http_requests_total{status=~'5..'}[5m])",
            "legendFormat": "5xx Errors",
            "refId": "A"
          },
          {
            "expr": "rate(http_requests_total{status=~'4..'}[5m])",
            "legendFormat": "4xx Errors",
            "refId": "B"
          }
        ],
        "yaxes": [{"format": "reqps", "label": "Errors/sec"}]
      },
      {
        "id": 7,
        "title": "Pod CPU Usage",
        "type": "graph",
        "gridPos": {"x": 16, "y": 16, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{pod=~'timeseries-transformer.*'}[5m])",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "percentunit", "label": "CPU Usage"}]
      },
      {
        "id": 8,
        "title": "Pod Memory Usage",
        "type": "graph",
        "gridPos": {"x": 0, "y": 22, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "container_memory_usage_bytes{pod=~'timeseries-transformer.*'} / 1024 / 1024 / 1024",
            "legendFormat": "{{pod}}",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "GB", "label": "Memory"}]
      },
      {
        "id": 9,
        "title": "Cache Hit Rate",
        "type": "graph",
        "gridPos": {"x": 8, "y": 22, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
            "legendFormat": "Cache Hit Rate",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "percentunit", "label": "Hit Rate"}]
      },
      {
        "id": 10,
        "title": "Database Connections",
        "type": "graph",
        "gridPos": {"x": 16, "y": 22, "w": 8, "h": 6},
        "targets": [
          {
            "expr": "pg_stat_database_numbackends{datname='timeseries'}",
            "legendFormat": "Active Connections",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "short", "label": "Connections"}]
      },
      {
        "id": 11,
        "title": "Model Drift Score",
        "type": "graph",
        "gridPos": {"x": 0, "y": 28, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "model_drift_score",
            "legendFormat": "Drift Score - {{model_version}}",
            "refId": "A"
          }
        ],
        "yaxes": [{"format": "short", "label": "Drift Score"}],
        "thresholds": [
          {"value": 0.1, "color": "yellow"},
          {"value": 0.2, "color": "red"}
        ]
      },
      {
        "id": 12,
        "title": "Business Metrics",
        "type": "table",
        "gridPos": {"x": 12, "y": 28, "w": 12, "h": 6},
        "targets": [
          {
            "expr": "model_sharpe_ratio",
            "legendFormat": "Sharpe Ratio",
            "refId": "A"
          },
          {
            "expr": "model_cumulative_returns",
            "legendFormat": "Cumulative Returns",
            "refId": "B"
          },
          {
            "expr": "model_max_drawdown",
            "legendFormat": "Max Drawdown",
            "refId": "C"
          }
        ]
      }
    ],
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"]
    }
  }
}